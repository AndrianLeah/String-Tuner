	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.3.1",
		"@types/node": "^24.12.2",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.6.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
